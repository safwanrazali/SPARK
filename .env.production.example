# =============================================================================
# TEMPLAT KONFIGURASI PENGELUARAN — FASA 13
# Sistem Pemantauan & Pelaporan Analisis Data Migrasi PQC
# =============================================================================
#
# Salin fail ini kepada .env pada pelayan, kemudian isikan setiap nilai yang
# ditanda <ISI>. JANGAN commit .env yang telah diisi ke dalam repositori.
#
#   cp .env.production.example .env
#   php artisan key:generate
#
# Semak dengan: php artisan about
# =============================================================================

APP_NAME="Sistem Pemantauan & Pelaporan Analisis Data Migrasi PQC"

# WAJIB: 'production' mengaktifkan perlindungan tambahan rangka kerja.
APP_ENV=production

# WAJIB: dijana oleh `php artisan key:generate`. Tanpa kunci ini, sesi dan
# data yang disulitkan tidak boleh dibaca.
APP_KEY=<ISI>

# WAJIB: 'false'. Nilai 'true' mendedahkan surih tindanan, laluan fail dan
# nilai konfigurasi kepada pengguna apabila berlaku ralat.
APP_DEBUG=false

# WAJIB: URL sebenar sistem, termasuk https://
APP_URL=<ISI>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Zon waktu rekod. Lihat amaran dalam docs/ADMIN_GUIDE.md sebelum menukar
# nilai ini pada sistem yang telah mempunyai data.
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

# Kos cincangan kata laluan. Jangan turunkan di bawah 12.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LOG
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null

# 'debug' merekod terlalu banyak maklumat pada pelayan pengeluaran.
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# PANGKALAN DATA
# -----------------------------------------------------------------------------
# Sistem menggunakan SQLite. Berikan laluan MUTLAK supaya tugasan berjadual
# dan skrip sandaran merujuk fail yang sama.
#
# Fail pangkalan data MESTI berada di luar direktori public/ dan hanya boleh
# dibaca oleh pengguna proses web.
DB_CONNECTION=sqlite
DB_DATABASE=<ISI: cth. /var/www/spark/database/database.sqlite>

# -----------------------------------------------------------------------------
# SESI — pengerasan keselamatan
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Sulitkan kandungan sesi yang disimpan dalam pangkalan data.
SESSION_ENCRYPT=true

SESSION_PATH=/
SESSION_DOMAIN=null

# WAJIB 'true' apabila sistem disajikan melalui HTTPS: kuki sesi tidak akan
# dihantar melalui sambungan HTTP biasa.
SESSION_SECURE_COOKIE=true

# Halang JavaScript daripada membaca kuki sesi.
SESSION_HTTP_ONLY=true

# Halang kuki sesi daripada dihantar oleh tapak lain (perlindungan CSRF).
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# CACHE / BARISAN
# -----------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# AKAUN PENTADBIR AWAL
# -----------------------------------------------------------------------------
# Digunakan sekali sahaja oleh `php artisan db:seed` semasa pemasangan.
# WAJIB diisi pada pelayan pengeluaran — seeder akan gagal tanpa nilai ini.
# Tukar kata laluan melalui antara muka selepas log masuk pertama.
ADMIN_USERNAME=<ISI>
ADMIN_NAME="Pentadbir Sistem"
ADMIN_EMAIL=<ISI>
ADMIN_PASSWORD=<ISI>

# -----------------------------------------------------------------------------
# MEL
# -----------------------------------------------------------------------------
# Sistem tidak menghantar e-mel dalam V1.0. Kekalkan 'log'.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.gov.my"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
